// Lo-fi hip hop: slow TR-808 drums, piano chords and a soft vibraphone melody.
setcpm(78/4)
drums: s("bd ~ ~ bd, ~ sd, hh*8").bank("RolandTR808").gain("1 .9 .7").gain(.7)
chords: chord("<Cm9 Fm9 Bb9 Ebmaj7>").voicing().s("piano").room(.5).gain(.6)
bass: note("<c2 f1 bb1 eb2>").s("triangle").lpf(600).gain(.9)
melody: n("<[4 ~ 2 ~] [~ 1 ~ 3] [0 ~ ~ 2] [~ ~ 4 ~]>").scale("C4:minor").s("vibraphone").room(.6).gain(1)
