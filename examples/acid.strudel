// Acid techno: TR-909 drums and a sawtooth bass under a moving filter.
setcpm(128/4)
drums: s("bd*4, [~ cp]*2, [~ hh]*4, ~ ~ ~ oh").bank("RolandTR909").gain(.55)
acid: note("<c2 c2 c3 c2> [~ eb2] [g1 c2] [~ bb1]").s("sawtooth")
  .lpf(sine.range(300, 2400).slow(8)).lpq(12).decay(.15).sustain(.2).gain(1.6)
stab: note("<[c4,eb4,g4] ~ ~ [bb3,d4,f4]>").s("square").lpf(1800).decay(.2).sustain(0).room(.5).gain(.7)
